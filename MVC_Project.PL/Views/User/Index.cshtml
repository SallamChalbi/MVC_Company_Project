@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string InputValue = ViewBag.InputValue;
}

@if (Model.Count() > 0 || InputValue?.Length > 0)
{
    <h1 class="mt-5">All Users</h1>
    <div class="m-3 row justify-content-center align-content-center">
        <form class="row col-10">
            <div class="col-8 pe-0">
                <input class="form-control" type="text" name="email" placeholder="Search by Email..." />
            </div>
            <div class="col-2">
                <input class="btn btn-success" type="submit" value="Search" />
            </div>
        </form>
    </div>
    @if (Model.Count() > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(U => U.Id)</th>
                    <th>@Html.DisplayNameFor(U => U.FName)</th>
                    <th>@Html.DisplayNameFor(U => U.LName)</th>
                    <th>@Html.DisplayNameFor(U => U.Email)</th>
                    <th>@Html.DisplayNameFor(U => U.PhoneNumber)</th>
                    <th>@Html.DisplayNameFor(U => U.Roles)</th>
                    <th>Details</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.FName</td>
                        <td>@user.LName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>@string.Join(",", user.Roles!)</td>
                        <partial name="_ButtonsPartialView" model="user.Id" />
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="mt-3 alert alert-secondary">
            <h3>There is No Email much this Input: '<span class="text-info">@InputValue</span>' !</h3>
        </div>
    }
}
else
{
    <div class="mt-3 alert alert-warning">
        <h3>There is No User !</h3>
    </div>
}