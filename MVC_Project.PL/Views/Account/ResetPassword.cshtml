@model ResetPasswordViewModel
@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="ResetPassword" method="post">
			<div asp-validation-summary="All" class="text-warning"></div>
			<div class="password-wrapper">
				<input class="text" asp-for="NewPassword" placeholder="New Password" required="">
				<span class="toggle-password" onclick="togglePassword(this)">
					<i class="fa fa-eye"></i>
				</span>
			</div>
			<span asp-validation-for="NewPassword" class="text-danger"></span>
			<div class="password-wrapper">
				<input class="text w3lpass" asp-for="ConfirmPassword" placeholder="Confirm Password" required="">
				<span class="toggle-password" onclick="togglePassword(this)">
					<i class="fa fa-eye"></i>
				</span>
			</div>
			<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
			
			<input type="submit" value="Reset Password">
		</form>
	</div>
</div>
@section ValidationSection {
	<partial name="_ValidationScriptsPartial" />
}