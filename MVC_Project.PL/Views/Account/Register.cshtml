@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="Register" method="post">
			<div asp-validation-summary="All" class="text-warning"></div>
			<input class="text" asp-for="FName" placeholder="First Name" required="">
			<span asp-validation-for="FName" class="text-danger"></span>
			<input class="text" asp-for="LName" placeholder="Last Name" required="">
			<span asp-validation-for="LName" class="text-danger"></span>
			<input class="text email" asp-for="Email" placeholder="E-Mail" required="">
			<span asp-validation-for="Email" class="text-danger"></span>
			<div class="password-wrapper">
				<input class="text" asp-for="Password" placeholder="Password" required="">
				<span class="toggle-password" onclick="togglePassword(this)">
					<i class="fa fa-eye"></i>
				</span>
			</div>
			<span asp-validation-for="Password" class="text-danger"></span>

			<div class="password-wrapper">
				<input class="text w3lpass" asp-for="ConfirmPassword" placeholder="Confirm Password" required="">
				<span class="toggle-password" onclick="togglePassword(this)">
					<i class="fa fa-eye"></i>
				</span>
			</div>
			<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
			<div class="wthree-text">
				<label class="anim">
					<input asp-for="IsAgree" class="checkbox" required="">
					<span>I Agree To The Terms & Conditions</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNUP">
		</form>
		<p>Do you have an Account? <a asp-action="Login"> Login Now!</a></p>
	</div>
</div>
@section ValidationSection {
	<partial name="_ValidationScriptsPartial" />
}