@model Department
@{
    ViewData["Title"] = "Delete";
}

<h1 class="m-3">Are You Sure You Want To Delete <span class="text-danger">@Model.Name</span> Department?</h1>

<div asp-validation-summary="All"></div>
<form asp-action="Delete">
    <partial name="PartialViews/_DeleteDetailsPartialView" />

    <div class="mt-3">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>