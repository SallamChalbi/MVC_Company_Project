@model IEnumerable<EmployeeViewModel>
@{
    ViewData["Title"] = "Index";
    // // Enforce type Safety => Requires Casting
    // string viewDataMessage = (ViewData["Message"] as string)!;
    // // Don't Enforce type Safety => Not Requires Casting
    // string viewBagMessage = ViewBag.Message;
    string InputValue = ViewBag.InputValue;
}

<a asp-action="Create" class="m-3 btn btn-success">Create New Employee</a>
@if(TempData["Message"] is not null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (Model.Count() > 0 || InputValue?.Length > 0)
{
    <h1 class="mt-5">All Employees</h1>
    <div class="m-3 row justify-content-center align-content-center">
        <form class="row col-10">
            <div class="col-8 pe-0">
                <input class="form-control" type="text" name="SearchValue" placeholder="Search by Name..." />
            </div>
            <div class="col-2">
                <input class="btn btn-success" type="submit" value="Search" />
            </div>
        </form>
    </div>
    @if (Model.Count() > 0)
    {
        <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(E => E.Image)</th>
                <th>@Html.DisplayNameFor(E => E.Name)</th>
                <th>@Html.DisplayNameFor(E => E.Age)</th>
                <th>@Html.DisplayNameFor(E => E.Salary)</th>
                <th>@Html.DisplayNameFor(E => E.Department)</th>
                <th>@Html.DisplayNameFor(E => E.Address)</th>
                <th>@Html.DisplayNameFor(E => E.Email)</th>
                <th>@Html.DisplayNameFor(E => E.PhoneNumber)</th>
                <th>@Html.DisplayNameFor(E => E.HireDate)</th>
                <th>@Html.DisplayNameFor(E => E.IsActive)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                            <img src="~/Files/Images/@employee.ImageName" class="w-100 rounded-circle" width="100" height="100" alt="Employee Image" />
                    </td>
                    <td>@employee.Name</td>
                    <td>@employee.Age</td>
                    <td>@Html.DisplayFor(E => employee.Salary)</td>
                    <td>
                        @if(employee.Department is not null)
                        {
                            @employee.Department.Name
                        }
                        else
                        {
                            <span class="text-muted">No Department</span>
                        }
                    </td>
                    <td>@employee.Address</td>
                    <td>@Html.DisplayFor(E => employee.Email)</td>
                    <td>@employee.PhoneNumber</td>
                    <td>@employee.HireDate</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <i class="fas fa-circle text-success fs-4"></i>
                        }
                        else
                        {
                            <i class="fas fa-circle text-danger fs-4"></i>
                        }
                    </td>
                    <partial name="_ButtonsPartialView" model="employee.Id.ToString()" />
                </tr>
            }
        </tbody>
    </table>
    }
    else
    {
        <div class="mt-3 alert alert-secondary">
            <h3>There is No Name much this Input: '<span class="text-info">@InputValue</span>' !</h3>
        </div>
    }
}
else
{
    <div class="mt-3 alert alert-warning">
        <h3>There is No Employee !</h3>
    </div>
}