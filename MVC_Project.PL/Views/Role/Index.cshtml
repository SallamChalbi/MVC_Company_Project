@model IEnumerable<RoleViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string InputValue = ViewBag.InputValue;
}

<a asp-action="Create" class="m-3 btn btn-success">Create New Role</a>

@if (Model.Count() > 0 || InputValue?.Length > 0)
{
    <h1 class="mt-5">All Roles</h1>
    <div class="m-3 row justify-content-center align-content-center">
        <form class="row col-10">
            <div class="col-8 pe-0">
                <input class="form-control" type="text" name="name" placeholder="Search by Name..." />
            </div>
            <div class="col-2">
                <input class="btn btn-success" type="submit" value="Search" />
            </div>
        </form>
    </div>
    @if (Model.Count() > 0)
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(R => R.Id)</th>
                    <th>@Html.DisplayNameFor(R => R.RoleName)</th>
                    <th>Details</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Id</td>
                        <td>@role.RoleName</td>
                        <partial name="_ButtonsPartialView" model="role.Id" />
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="mt-3 alert alert-secondary">
            <h3>There is No Role Name much this Input: '<span class="text-info">@InputValue</span>' !</h3>
        </div>
    }
}
else
{
    <div class="mt-3 alert alert-warning">
        <h3>There is No Role !</h3>
    </div>
}